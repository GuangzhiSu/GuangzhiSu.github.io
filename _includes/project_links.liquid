{% comment %}
  Tag chips and action buttons for a project.
  Usage: {% include project_links.liquid project=project %} (card)
         {% include project_links.liquid %}                 (project page, uses `page`)
  Front matter it reads: tags, github, website, demo, video, download, paper
{% endcomment %}
{% if include.project %}
  {% assign p = include.project %}
{% else %}
  {% assign p = page %}
{% endif %}

{% if p.tags and p.tags.size > 0 %}
  <div class="project-tags">
    {% for tag in p.tags %}
      <span class="project-tag">{{ tag }}</span>
    {% endfor %}
  </div>
{% endif %}

{% if p.github or p.website or p.demo or p.video or p.download or p.paper %}
  <div class="project-links{% if include.size == 'lg' %} project-links-lg{% endif %}">
    {% if p.website %}
      <a class="project-link project-link-primary" href="{{ p.website }}" target="_blank" rel="noopener"
        ><i class="fa-solid fa-arrow-up-right-from-square"></i> Website</a
      >
    {% endif %}
    {% if p.demo %}
      <a class="project-link project-link-primary" href="{{ p.demo }}" target="_blank" rel="noopener"
        ><i class="fa-solid fa-play"></i> Live demo</a
      >
    {% endif %}
    {% if p.video %}
      <a class="project-link" href="{{ p.video }}" target="_blank" rel="noopener"><i class="fa-brands fa-youtube"></i> Video</a>
    {% endif %}
    {% if p.download %}
      <a class="project-link" href="{{ p.download }}" target="_blank" rel="noopener"><i class="fa-solid fa-mobile-screen-button"></i> Get the app</a>
    {% endif %}
    {% if p.paper %}
      <a class="project-link" href="{{ p.paper }}" target="_blank" rel="noopener"><i class="fa-regular fa-file-lines"></i> Paper</a>
    {% endif %}
    {% if p.github %}
      <a class="project-link" href="{{ p.github }}" target="_blank" rel="noopener"><i class="fa-brands fa-github"></i> Code</a>
    {% endif %}
  </div>
{% endif %}
