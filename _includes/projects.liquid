{% if project.redirect %}
  {% assign project_url = project.redirect %}
{% else %}
  {% assign project_url = project.url | relative_url %}
{% endif %}
<div class="col">
  <div class="card h-100 hoverable project-card">
    {% if project.img %}
      <a class="project-card-img" href="{{ project_url }}" aria-label="{{ project.title }}">
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "(min-width: 768px) 350px, 95vw"
          alt=project.title
          class="card-img-top"
        %}
      </a>
    {% endif %}
    <div class="card-body">
      {% if project.badge %}
        <span class="project-badge">{{ project.badge }}</span>
      {% endif %}
      <a href="{{ project_url }}">
        <h2 class="card-title">{{ project.title }}</h2>
      </a>
      <p class="card-text">{{ project.description }}</p>
      {% include project_links.liquid project=project %}
    </div>
  </div>
</div>
