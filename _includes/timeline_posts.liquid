<div class="timeline-posts">
  {% if site.posts.size > 0 %}
    {% assign posts_by_year = site.posts | group_by_exp: "post", "post.date | date: '%Y'" | sort: "name" | reverse %}
    
    <ul class="timeline">
      {% for year_group in posts_by_year %}
        <li class="timeline-year">{{ year_group.name }}</li>
        
        {% assign sorted_posts = year_group.items | sort: "date" | reverse %}
        {% for post in sorted_posts %}
          <li>
            <div class="timeline-content">
              <div class="timeline-date">{{ post.date | date: '%B' }}</div>
              <div class="timeline-text">
                {% if post.redirect %}
                  {% if post.redirect contains '://' %}
                    <a href="{{ post.redirect }}" target="_blank">{{ post.description | default: post.title }}</a>
                    <svg width="1rem" height="1rem" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" style="display: inline-block; vertical-align: middle; margin-left: 0.25rem;">
                      <path d="M17 13.5v6H5v-12h6m3-3h6v6m0-6-9 9" class="icon_svg-stroke" stroke="#999" stroke-width="1.5" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  {% else %}
                    <a href="{{ post.redirect | relative_url }}">{{ post.description | default: post.title }}</a>
                  {% endif %}
                {% else %}
                  {% if post.description %}
                    {{ post.description }}
                  {% else %}
                    {{ post.title }}
                  {% endif %}
                {% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  {% else %}
    <p>No posts so far...</p>
  {% endif %}
</div>

